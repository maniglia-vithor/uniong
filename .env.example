# Copie para .env e preencha. Nunca versione o .env.
# Variáveis marcadas com [produção] são obrigatórias quando DEBUG=False:
# o Django se recusa a iniciar sem elas.

# ── Geral ─────────────────────────────────────────────────────────────
# True só em desenvolvimento local. Padrão: False.
DEBUG=True

# [produção] Chave longa e aleatória (50+ caracteres). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# [produção] Domínios atendidos pelo backend, separados por vírgula.
ALLOWED_HOSTS=localhost,127.0.0.1

# [produção] Origens do frontend autorizadas a chamar a API (com https:// em produção).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Endereço público do frontend (prévias /c/<id>/ e links enviados por e-mail).
FRONTEND_URL=http://localhost:5173

# Origens confiáveis para formulários com CSRF (ex.: admin do Django atrás de proxy).
CSRF_TRUSTED_ORIGINS=

# ── Banco de dados (MySQL) ────────────────────────────────────────────
DB_NAME=ong_db
DB_USER=root
DB_PASSWORD=sua-senha-aqui
DB_HOST=localhost
DB_PORT=3306

# ── Login com Google ──────────────────────────────────────────────────
# ID do cliente OAuth (tipo "Aplicativo da Web") do Google Cloud. Vazio desativa o login com Google.
# Use o mesmo valor em ong_frontend/.env.local como VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ── Sessão e limites ──────────────────────────────────────────────────
# Validade do access token em minutos (o refresh vale 7 dias e é rotacionado).
JWT_ACCESS_MINUTOS=60
# Limites por IP no formato "quantidade/periodo" (sec, min, hour, day).
THROTTLE_AUTH=10/min
THROTTLE_DOACAO_PUBLICA=5/min
# Quantidade de proxies reversos à frente do Django (ex.: 1 com Nginx). 0 ignora X-Forwarded-For.
NUM_PROXIES=0

# ── Arquivos ──────────────────────────────────────────────────────────
# Pasta dos anexos de despesas (privada, fora do /media). Padrão: <projeto>/privado
PRIVATE_MEDIA_ROOT=

# ── Segurança HTTPS (aplicada apenas com DEBUG=False) ────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# HSTS: o navegador passa a exigir HTTPS pelo período informado (segundos).
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# Inscrever o domínio na lista de pré-carregamento dos navegadores é difícil de desfazer;
# deixe False até ter certeza (o check --deploy avisa com security.W021).
SECURE_HSTS_PRELOAD=False
# True quando um proxy (Nginx, Render, Railway...) termina o HTTPS e envia X-Forwarded-Proto.
USAR_PROXY_HTTPS=False

# ── E-mail (convites da equipe, recuperação de senha, recibos e comunicados) ──
# Em desenvolvimento o padrão imprime as mensagens no terminal do runserver.
# Em produção use django.core.mail.backends.smtp.EmailBackend e preencha os dados do SMTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=UniONG <nao-responda@localhost>
# Validade do link de redefinição de senha, em segundos (padrão: 2 horas). O convite vale 72 horas.
PASSWORD_RESET_TIMEOUT=7200
